# ═══════════════════════════════════════════════════════
# ANDEX — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# SIN estas variables, la app corre en MODO DEMO:
#   - sesión y datos en el navegador (localStorage + cookie)
#   - checkout simulado (sin cobro real)
# ═══════════════════════════════════════════════════════

# ── Supabase (Auth + PostgreSQL) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (webhooks Stripe, jobs). NUNCA exponer con NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precio creados en el dashboard de Stripe
# Mensual $14 USD · Anual $140 USD (tarifa congelada — ver PRD §3.4.4:
# el price_id de cada suscripción queda fijado de por vida, nunca migrar masivamente)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Tienda: enlaces de las miniaplicaciones ──
# Cada una se enciende poniendo su URL. Sin ella, la tarjeta sale como
# "muy pronto" con su captación de interés. Deben ser https y NO pueden
# llevar datos del usuario en la URL (lib/tienda/enlaces.ts lo rechaza).
NEXT_PUBLIC_APP_PRIMERA_AUDIENCIA=
NEXT_PUBLIC_APP_PRIMEROS_DOLARES=
